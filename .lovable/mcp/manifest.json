{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dauyjjnbxehmfcbpeoxr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sorarehub",
      "version": "0.1.0",
      "title": "SorareHub"
    },
    "tools": [
      {
        "name": "get_overview",
        "title": "Panoramica account",
        "description": "Riepilogo dell'account: carte in galleria, spesa totale, plusvalenze, vincite per competizione e statistiche arene.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_cards",
        "title": "Elenca carte",
        "description": "Elenca le carte in galleria dell'utente, con filtri opzionali per nome, rarità, stagione, ruolo e competizione.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Testo cercato in nome o seriale."
            },
            "rarity": {
              "type": "string",
              "enum": [
                "LIMITED",
                "RARE",
                "SR",
                "UNIQUE"
              ]
            },
            "season": {
              "type": "string",
              "description": "Es. 25/26"
            },
            "role": {
              "type": "string",
              "enum": [
                "GK",
                "DF",
                "MD",
                "FW"
              ]
            },
            "competition": {
              "type": "string"
            },
            "includeSold": {
              "type": "boolean",
              "description": "Includi anche le carte già vendute (default false)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sales",
        "title": "Plusvalenze",
        "description": "Elenca le carte vendute con la plusvalenza per carta e il totale complessivo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "roi_leaderboard",
        "title": "Classifica ROI",
        "description": "Classifica dei giocatori per ROI, ordinabile per soldi vinti o essenze vinte.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sortBy": {
              "type": "string",
              "enum": [
                "cash",
                "essences"
              ],
              "description": "Default: cash"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_card",
        "title": "Aggiungi carta",
        "description": "Aggiunge una nuova carta alla galleria dell'utente (blocca i duplicati esatti: nome, stagione, rarità, seriale).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "season": {
              "type": "string",
              "minLength": 1,
              "description": "Es. 25/26"
            },
            "competition": {
              "type": "string",
              "minLength": 1,
              "description": "Deve essere una competizione già esistente."
            },
            "buy": {
              "type": "number",
              "minimum": 0,
              "description": "Prezzo di acquisto in €."
            },
            "rarity": {
              "type": "string",
              "enum": [
                "LIMITED",
                "RARE",
                "SR",
                "UNIQUE"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "GK",
                "DF",
                "MD",
                "FW"
              ]
            },
            "serial": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "season",
            "competition",
            "buy"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "sell_card",
        "title": "Registra vendita",
        "description": "Registra il prezzo di vendita di una carta: la carta passa nella sezione Plusvalenze.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "season": {
              "type": "string",
              "minLength": 1
            },
            "serial": {
              "type": "string",
              "description": "Utile per distinguere copie identiche."
            },
            "sell": {
              "type": "number",
              "minimum": 0,
              "description": "Prezzo di vendita in €."
            }
          },
          "required": [
            "name",
            "season",
            "sell"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
